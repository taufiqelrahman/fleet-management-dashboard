datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  password    String
  name        String?
  role        Role         @default(OPERATOR)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attendances Attendance[]
  timesheets  Timesheet[]
  shifts      Shift[]
}

model Vehicle {
  id              String           @id @default(cuid())
  name            String
  type            VehicleType
  licensePlate    String           @unique
  status          VehicleStatus    @default(ACTIVE)
  driverId        String?
  driverName      String?
  lastMaintenance DateTime?
  nextMaintenance DateTime?
  mileage         Float            @default(0)
  fuelConsumption Float            @default(0)
  latitude        Float?
  longitude       Float?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  trips           Trip[]
  timesheets      Timesheet[]
}

model Trip {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime?
  distance    Float
  fuelUsed    Float
  destination String
  driverName  String
  createdAt   DateTime @default(now())
}

enum Role {
  ADMIN
  OPERATOR
  EMPLOYEE
  SUPERVISOR
  HR
}

enum VehicleType {
  SEDAN
  SUV
  TRUCK
  VAN
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

model Attendance {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime         @default(now())
  clockIn   DateTime
  clockOut  DateTime?
  status    AttendanceStatus @default(PRESENT)
  location  String?
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, date])
}

model Timesheet {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId    String?
  vehicle      Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  activityType ActivityType
  startTime    DateTime
  endTime      DateTime?
  duration     Float?
  description  String?
  location     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId, startTime])
  @@index([vehicleId, startTime])
}

model Shift {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftType   ShiftType
  startTime   DateTime
  endTime     DateTime
  status      ShiftStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId, startTime])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

enum ActivityType {
  DRIVING
  MAINTENANCE
  INSPECTION
  FUELING
  CLEANING
  PARKING
  OTHER
}

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
  FLEXIBLE
}

enum ShiftStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}
