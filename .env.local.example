# Database Configuration
# PostgreSQL from Neon (https://neon.tech)
# Replace with your actual Neon database connection string
DATABASE_URL="postgresql://username:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require"

# NextAuth Configuration
# Change this URL to your production domain
NEXTAUTH_URL="http://localhost:3000"

# Generate a secure secret with: openssl rand -base64 32
# IMPORTANT: Change this in production!
NEXTAUTH_SECRET="change-this-to-a-secure-random-string-in-production"

# Optional: Node Environment
NODE_ENV="development"
